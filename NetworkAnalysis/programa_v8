  caminho_blacklist = BLACKLIST_PATH_DEFAULT

  config = {
    ficheiro: "ficheiro.log",
    limite_segundos: 60,
    hora_inicio: HORA_INICIO_DEFAULT,
    hora_fim: HORA_FIM_DEFAULT,
    redes_internas: [],
    ficheiro_saida: nil,
    redes_doc: DOC_CIDRS_DEFAULT.dup,
    blacklist: carregar_blacklist(caminho_blacklist),
    blacklist_file: caminho_blacklist,
    geocode_file: nil,
    geocode_tabela: [],
    geocode_indice: [],
    repeticoes_alerta: 5,
    horas_distintas_alerta: 3
  }

  loop do
    mostrar_menu(config)
    opcao = gets&.chomp

    case opcao
    when "1"
      print "Novo nome/caminho do ficheiro de log: "
      novo = gets&.chomp
      config[:ficheiro] = novo unless novo.nil? || novo.strip.empty?

    when "2"
      print "Novo limite em segundos: "
      valor = gets&.chomp
      config[:limite_segundos] = valor.to_i if valor && valor.to_i > 0

    when "3"
      print "Nova hora de inicio (HH:MM): "
      ini = gets&.chomp
      print "Nova hora de fim (HH:MM): "
      fim = gets&.chomp
      if ini =~ /^\d{2}:\d{2}$/ && fim =~ /^\d{2}:\d{2}$/
        config[:hora_inicio] = ini
        config[:hora_fim] = fim
      else
        puts "Formato invalido. Mantidos os valores anteriores."
      end

    when "4"
      puts "Redes internas em CIDR, separadas por virgulas."
      puts "(vazio = RFC 1918: 10/8, 172.16/12, 192.168/16)"
      print "Redes/IPs: "
      valor = gets&.chomp
      config[:redes_internas] = (valor.nil? || valor.strip.empty?) ? [] :
        valor.split(",").map(&:strip).reject(&:empty?)

    when "5"
      print "Nome do ficheiro de saida (vazio = nao guardar): "
      valor = gets&.chomp
      config[:ficheiro_saida] = (valor.nil? || valor.strip.empty?) ? nil : valor

    when "6"
      puts "IPs reservadas para documentacao (RFC 5737 por omissao)."
      puts "Sugestoes: 192.0.2.0/24, 198.51.100.0/24, 203.0.113.0/24"
      puts "(vazio = repor omissao RFC 5737)"
      print "CIDRs: "
      valor = gets&.chomp
      if valor.nil? || valor.strip.empty?
        config[:redes_doc] = DOC_CIDRS_DEFAULT.dup
      else
        config[:redes_doc] = valor.split(",").map(&:strip).reject(&:empty?)
      end

    when "7"
      gerir_blacklist(config)

    when "8"
      puts "Ficheiro geocoder nos formatos:"
      puts "  CIDR,CC              -> ex.: 192.168.0.0/16,PT"
      puts "  IP_INI,IP_FIM,CC     -> ex.: 223.255.128.0,223.255.191.255,HK"
      print "Caminho do ficheiro (vazio = sem geocoder): "
      valor = gets&.chomp

      if valor.nil? || valor.strip.empty?
        config[:geocode_file] = nil
        config[:geocode_tabela] = []
        config[:geocode_indice] = []
        puts "Geocoder removido."
      else
        caminho = valor.strip

        if !File.exist?(caminho)
          alternativo = File.join(__dir__, caminho)
          caminho = alternativo if File.exist?(alternativo)
        end

        if !File.exist?(caminho)
          puts "ERRO: ficheiro '#{caminho}' nao encontrado."
          puts "Pasta atual:     #{Dir.pwd}"
          puts "Pasta do script: #{__dir__}"
          puts "Ficheiros .txt/.csv na pasta do script:"
          Dir.glob(File.join(__dir__, "*.{txt,csv}")).each { |f| puts "  - #{f}" }
        elsif File.zero?(caminho)
          puts "ERRO: ficheiro '#{caminho}' esta vazio."
        else
          config[:geocode_file] = caminho
          config[:geocode_tabela] = carregar_geocode(caminho)
          config[:geocode_indice] = construir_indice_geocode(config[:geocode_tabela])
          puts "Carregadas #{config[:geocode_tabela].length} entradas " \
               "(indice com #{config[:geocode_indice].length} intervalos)."

          if config[:geocode_tabela].empty?
            puts "AVISO: ficheiro existe mas nenhuma linha foi aceite."
            puts "Primeiras 3 linhas:"
            File.foreach(caminho).first(3).each { |l| puts "  > #{l.chomp}" }
          end
        end
      end

    when "9"
      print "Numero minimo de repeticoes (IP,MAC) para alerta: "
      valor = gets&.chomp
      config[:repeticoes_alerta] = valor.to_i if valor && valor.to_i > 0

    when "10"
      print "Numero minimo de horas distintas para alertar IP: "
      valor = gets&.chomp
      config[:horas_distintas_alerta] = valor.to_i if valor && valor.to_i > 0

    when "11"
      analisar(config)

    when "0"
      puts "A sair..."
      break

    else
      puts "Opcao invalida."
    end
  end
end

# ==========================================
# ANALISE PRINCIPAL
# ==========================================

def analisar(config)
  saida = []
  registar = lambda do |linha|
    puts linha
    saida << linha
  end

  registar.call("==========================================")
  registar.call(" Analise das reconexoes dos equipamentos")
  registar.call(" Versao 8 - blacklist persistente")
  registar.call("==========================================")
  registar.call("Horario permitido: #{config[:hora_inicio]} - #{config[:hora_fim]}")
  registar.call("Limite de reconexao suspeita: #{config[:limite_segundos]}s")
  registar.call("IPs documentacao: #{config[:redes_doc].join(', ')}")
  registar.call("Blacklist: #{config[:blacklist].empty? ? '(vazia)' : "#{config[:blacklist].length} entrada(s)"}")
  registar.call("Geocoder: #{config[:geocode_file] || '(nenhum)'} " \
                "(#{config[:geocode_tabela].length} entradas, " \
                "#{config[:geocode_indice].length} intervalos indexados)")
  registar.call("")

  unless File.exist?(config[:ficheiro])
    puts "ERRO: ficheiro '#{config[:ficheiro]}' nao encontrado."
    return
  end

  ultima_ocorrencia = {}
  contagem_ip       = Hash.new(0)
  ips_suspeitos     = Hash.new(0)
  ips_fora_horario  = Hash.new(0)
  ips_externos      = Hash.new(0)
  ips_doc           = Hash.new(0)
  ips_blacklist     = Hash.new(0)
  ip_para_pais      = {}
  ips_para_macs     = Hash.new { |h, k| h[k] = Hash.new(0) }
  macs_para_ips     = Hash.new { |h, k| h[k] = Hash.new(0) }
  horas_por_ip      = Hash.new { |h, k| h[k] = {} }

  dns_ok   = Hash.new(0)
  dns_fail = Hash.new(0)
  nack     = Hash.new(0)

  buckets_intervalo = Hash.new(0)
  buckets_por_ip    = Hash.new { |h, k| h[k] = Hash.new(0) }

  repeticoes_par = Hash.new(0)

  geocode_indice = config[:geocode_indice] || construir_indice_geocode(config[:geocode_tabela])

  File.open(config[:ficheiro], "r") do |f1|
    f1.each_line do |linha|
      linha = linha.gsub(/\\[rn]+\z/, "").chomp

      next unless linha =~ EXP_REG_ID

      ip = linha[EXP_REG_IP]
      next unless ip

      mac = linha[EXP_REG_MAC]
      mac = mac.strip.upcase if mac

      data = linha.match(EXP_REG_DATA)
      next unless data
      begin
        data_hora = parse_data_hora(data[1], data[2])
      rescue ArgumentError
        next
      end

      externo   = !ip_interno?(ip, config[:redes_internas])
      doc_flag  = ip_documentacao?(ip, config[:redes_doc])
      bl_flag   = ip_na_blacklist?(ip, config[:blacklist])

      pais = pais_do_log(linha)
      pais ||= pais_do_ip_rapido(ip, geocode_indice)

      contagem_ip[ip] += 1
      horas_por_ip[ip][data_hora.hour] = true
      ip_para_pais[ip] ||= pais

      ips_externos[ip]  += 1 if externo
      ips_doc[ip]       += 1 if doc_flag
      ips_blacklist[ip] += 1 if bl_flag

      if mac
        ips_para_macs[ip][mac] += 1
        macs_para_ips[mac][ip] += 1
        repeticoes_par[[ip, mac]] += 1
      end

      dns_ok[ip]   += 1 if linha =~ EXP_REG_DNS_OK
      dns_fail[ip] += 1 if linha =~ EXP_REG_DNS_FAIL
      nack[ip]     += 1 if linha =~ EXP_REG_NACK

      fora_flag = false
      if fora_do_horario?(data_hora, config[:hora_inicio], config[:hora_fim])
        ips_fora_horario[ip] += 1
        fora_flag = true
      end

      unless ultima_ocorrencia.key?(ip)
        ultima_ocorrencia[ip] = data_hora
        registar.call("IP: #{ip} (#{externo ? 'EXTERNO' : 'interno'}) | MAC: #{mac} | Pais: #{pais}")
        registar.call("Primeira ocorrencia: #{data_hora}")
        registar.call("***** ALERTA: IP EXTERNO *****") if externo
        registar.call("***** ALERTA: IP DE DOCUMENTACAO *****") if doc_flag
        registar.call("***** ALERTA: IP EM BLACKLIST *****") if bl_flag
        registar.call("***** OCORRENCIA FORA DO HORARIO *****") if fora_flag
        registar.call("")
        next
      end

      anterior = ultima_ocorrencia[ip]
      diferenca = (data_hora - anterior).to_i
      horas, resto = diferenca.divmod(3600)
      minutos, segundos = resto.divmod(60)

      bucket = bucket_intervalo(diferenca)
      buckets_intervalo[bucket] += 1
      buckets_por_ip[ip][bucket] += 1

      registar.call("IP: #{ip} (#{externo ? 'EXTERNO' : 'interno'}) | MAC: #{mac} | Pais: #{pais}")
      registar.call("Anterior: #{anterior}")
      registar.call("Atual:    #{data_hora}")
      registar.call("Diferenca: #{horas}h #{minutos}m #{segundos}s (bucket #{bucket})")

      if diferenca < config[:limite_segundos]
        registar.call("***** RECONEXAO INFERIOR A #{config[:limite_segundos]}s *****")
        ips_suspeitos[ip] += 1
      end

      registar.call("***** ALERTA: IP EXTERNO *****") if externo
      registar.call("***** ALERTA: IP DE DOCUMENTACAO *****") if doc_flag
      registar.call("***** ALERTA: IP EM BLACKLIST *****") if bl_flag
      registar.call("***** OCORRENCIA FORA DO HORARIO *****") if fora_flag
      registar.call("")

      ultima_ocorrencia[ip] = data_hora
    end
  end

  # ==========================================
  # RESUMO POR IP
  # ==========================================
  registar.call("")
  registar.call("==========================================")
  registar.call(" RESUMO POR IP")
  registar.call("==========================================")
  registar.call("IPs distintos: #{ultima_ocorrencia.length}")
  registar.call("")

  ultima_ocorrencia.each_key do |ip|
    motivos = []
    motivos << "reconexoes<#{config[:limite_segundos]}s (#{ips_suspeitos[ip]}x)" if ips_suspeitos[ip] > 0
    motivos << "fora horario (#{ips_fora_horario[ip]}x)" if ips_fora_horario[ip] > 0
    motivos << "EXTERNO (#{ips_externos[ip]}x)" if ips_externos[ip] > 0
    motivos << "DOC (#{ips_doc[ip]}x)" if ips_doc[ip] > 0
    motivos << "BLACKLIST (#{ips_blacklist[ip]}x)" if ips_blacklist[ip] > 0
    motivos << "DNS_OK=#{dns_ok[ip]} DNS_FAIL=#{dns_fail[ip]}" if dns_ok[ip] + dns_fail[ip] > 0
    motivos << "NACK=#{nack[ip]}" if nack[ip] > 0
    if horas_por_ip[ip].size >= config[:horas_distintas_alerta]
      motivos << "aparece em #{horas_por_ip[ip].size} horas distintas"
    end
    if ips_para_macs[ip].size > 1
      motivos << "associado a #{ips_para_macs[ip].size} MACs"
    end

    linha = "#{ip} (#{ip_para_pais[ip]}) ocorrencias=#{contagem_ip[ip]}"
    linha += motivos.empty? ? " <-- normal" : " <-- SUSPEITO: #{motivos.join(' | ')}"
    registar.call(linha)
  end

  # ==========================================
  # RESUMO POR MAQUINA (MAC)
  # ==========================================
  registar.call("")
  registar.call("==========================================")
  registar.call(" RESUMO POR MAQUINA (MAC)")
  registar.call("==========================================")

  macs_para_ips.each do |mac, mapa_ips|
    total = mapa_ips.values.sum
    ips_unicos = mapa_ips.keys
    flag = ips_unicos.size > 1 ? " <-- SUSPEITO: MAC associado a #{ips_unicos.size} IPs" : ""
    registar.call("MAC #{mac}: #{total} ocorrencia(s), IPs=#{ips_unicos.join(', ')}#{flag}")
  end

  # ==========================================
  # RESUMO POR PAIS
  # ==========================================
  registar.call("")
  registar.call("==========================================")
  registar.call(" RESUMO POR PAIS")
  registar.call("==========================================")
  contagem_pais = Hash.new(0)
  contagem_pais_ips = Hash.new { |h, k| h[k] = {} }
  contagem_ip.each do |ip, n|
    cc = ip_para_pais[ip] || "??"
    contagem_pais[cc] += n
    contagem_pais_ips[cc][ip] = true
  end
  if contagem_pais.empty?
    registar.call("(sem dados de pais)")
  else
    contagem_pais.sort_by { |_, v| -v }.each do |cc, n|
      registar.call("#{cc}: #{n} ocorrencia(s) em #{contagem_pais_ips[cc].size} IP(s)")
    end
  end

  # ==========================================
  # BUCKETS DE INTERVALOS
  # ==========================================
  registar.call("")
  registar.call("==========================================")
  registar.call(" DISTRIBUICAO DOS INTERVALOS")
  registar.call("==========================================")
  ordem = ["0s","1s","2-4s","5-9s","10-29s","30-59s","1-5min","5-60min",">1h"]
  ordem.each do |b|
    next if buckets_intervalo[b].zero?
    registar.call("#{b.ljust(8)} -> #{buckets_intervalo[b]}")
  end

  # ==========================================
  # PADROES REPETITIVOS
  # ==========================================
  registar.call("")
  registar.call("==========================================")
  registar.call(" PADROES REPETITIVOS (par IP/MAC)")
  registar.call("==========================================")
  repetidos = repeticoes_par.select { |_, v| v >= config[:repeticoes_alerta] }
  if repetidos.empty?
    registar.call("(nenhum par IP/MAC atingiu #{config[:repeticoes_alerta]} repeticoes)")
  else
    repetidos.sort_by { |_, v| -v }.each do |(ip, mac), n|
      registar.call("#{ip} / #{mac} -> #{n} repeticoes")
    end
  end

  # ==========================================
  # DNS / NACK
  # ==========================================
  registar.call("")
  registar.call("==========================================")
  registar.call(" DNS E NACK")
  registar.call("==========================================")
  todos = (dns_ok.keys | dns_fail.keys | nack.keys)
  if todos.empty?
    registar.call("(sem registos DNS/NACK detetados)")
  else
    todos.sort.each do |ip|
      registar.call("#{ip}: DNS_OK=#{dns_ok[ip]} DNS_FAIL=#{dns_fail[ip]} NACK=#{nack[ip]}")
    end
  end

  # ==========================================
  # IPs DE DOCUMENTACAO / BLACKLIST / EXTERNOS
  # ==========================================
  if ips_doc.any?
    registar.call("")
    registar.call("==========================================")
    registar.call(" IPs DE DOCUMENTACAO DETETADOS")
    registar.call("==========================================")
    ips_doc.each { |ip, n| registar.call("#{ip} -> #{n} ocorrencia(s)") }
  end

  if ips_blacklist.any?
    registar.call("")
    registar.call("==========================================")
    registar.call(" IPs EM BLACKLIST")
    registar.call("==========================================")
    ips_blacklist.each { |ip, n| registar.call("#{ip} -> #{n} ocorrencia(s)") }
  end

  if ips_externos.any?
    registar.call("")
    registar.call("==========================================")
    registar.call(" IPs EXTERNOS")
    registar.call("==========================================")
    ips_externos.each { |ip, n| registar.call("#{ip} -> #{n} ocorrencia(s)") }
  end

  registar.call("")
  registar.call("==========================================")
  registar.call(" FIM DA ANALISE")
  registar.call("==========================================")

  if config[:ficheiro_saida]
    File.write(config[:ficheiro_saida], saida.join("\n") + "\n")
    puts
    puts "Relatorio guardado em: #{config[:ficheiro_saida]}"
  end
end

# ==========================================
# PONTO DE ENTRADA
# ==========================================

if __FILE__ == $0
  executar_menu
end
