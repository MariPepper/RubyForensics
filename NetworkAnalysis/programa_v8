# ==========================================
# GESTAO DA BLACKLIST
# ==========================================

def gerir_blacklist(config)
  caminho = config[:blacklist_file] || BLACKLIST_PATH_DEFAULT

  loop do
    puts
    puts "----- GESTAO DE BLACKLIST -----"
    puts "Ficheiro: #{caminho}"
    puts "Entradas atuais: #{config[:blacklist].length}"
    puts "1. Ver blacklist"
    puts "2. Adicionar IP/CIDR"
    puts "3. Remover IP/CIDR"
    puts "4. Recarregar do ficheiro"
    puts "5. Esvaziar blacklist (e ficheiro)"
    puts "0. Voltar"
    print "Opcao: "
    op = gets&.chomp

    case op
    when "1"
      if config[:blacklist].empty?
        puts "(blacklist vazia)"
      else
        config[:blacklist].each_with_index { |c, i| puts "  #{i + 1}. #{c}" }
      end

    when "2"
      print "IP/CIDR a adicionar (varios separados por virgula): "
      valor = gets&.chomp
      if valor.nil? || valor.strip.empty?
        puts "Nada a adicionar."
        next
      end
      novos = valor.split(",").map(&:strip).reject(&:empty?)
      invalidos = novos.reject { |c| cidr_valido?(c) }
      if invalidos.any?
        puts "Ignorados (formato invalido): #{invalidos.join(', ')}"
      end
      aceites = novos.select { |c| cidr_valido?(c) } - config[:blacklist]
      if aceites.empty?
        puts "Nada de novo a adicionar."
      else
        config[:blacklist].concat(aceites)
        guardar_blacklist(caminho, config[:blacklist])
        puts "Adicionados: #{aceites.join(', ')}"
        puts "Blacklist agora tem #{config[:blacklist].length} entrada(s)."
      end

    when "3"
      if config[:blacklist].empty?
        puts "Blacklist ja' esta vazia."
        next
      end
      config[:blacklist].each_with_index { |c, i| puts "  #{i + 1}. #{c}" }
      print "Numero(s) a remover (separados por virgula): "
      valor = gets&.chomp
      indices = (valor || "").split(",").map { |s| s.strip.to_i - 1 }.select { |i| i >= 0 }
      remover = indices.map { |i| config[:blacklist][i] }.compact.uniq
      if remover.empty?
        puts "Nada removido."
      else
        config[:blacklist] -= remover
        guardar_blacklist(caminho, config[:blacklist])
        puts "Removidos: #{remover.join(', ')}"
      end

    when "4"
      config[:blacklist] = carregar_blacklist(caminho)
      puts "Recarregadas #{config[:blacklist].length} entrada(s)."

    when "5"
      config[:blacklist] = []
      guardar_blacklist(caminho, [])
      puts "Blacklist esvaziada."

    when "0"
      break

    else
      puts "Opcao invalida."
    end
  end
end

